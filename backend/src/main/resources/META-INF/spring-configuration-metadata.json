{
  "groups": [
    {
      "name": "jwt",
      "type": "com.landverification.config.JwtProperties",
      "sourceType": "com.landverification.config.JwtProperties",
      "description": "JWT token configuration"
    },
    {
      "name": "blockchain",
      "type": "com.landverification.config.BlockchainProperties",
      "sourceType": "com.landverification.config.BlockchainProperties",
      "description": "Blockchain configuration"
    },
    {
      "name": "web3j",
      "type": "com.landverification.config.Web3jProperties",
      "sourceType": "com.landverification.config.Web3jProperties",
      "description": "Web3j configuration"
    },
    {
      "name": "app",
      "type": "com.landverification.config.AppProperties",
      "sourceType": "com.landverification.config.AppProperties",
      "description": "Application configuration"
    }
  ],
  "properties": [
    {
      "name": "jwt.secret",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.JwtProperties",
      "description": "JWT signing secret key"
    },
    {
      "name": "jwt.expiration-ms",
      "type": "java.lang.Long",
      "sourceType": "com.landverification.config.JwtProperties",
      "description": "JWT token expiration time in milliseconds",
      "defaultValue": 86400000
    },
    {
      "name": "blockchain.contract-address",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.BlockchainProperties",
      "description": "Ethereum smart contract address"
    },
    {
      "name": "blockchain.private-key",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.BlockchainProperties",
      "description": "Private key for blockchain transactions (dev only)"
    },
    {
      "name": "web3j.client-address",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.Web3jProperties",
      "description": "Web3j client connection address",
      "defaultValue": "http://127.0.0.1:8545"
    },
    {
      "name": "app.cors.allowed-origins",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.AppProperties.Cors",
      "description": "CORS allowed origins (comma-separated)"
    },
    {
      "name": "app.upload-dir",
      "type": "java.lang.String",
      "sourceType": "com.landverification.config.AppProperties",
      "description": "Directory for file uploads",
      "defaultValue": "./uploads"
    }
  ]
}
